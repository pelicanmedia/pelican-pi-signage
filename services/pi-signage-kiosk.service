[Unit]
Description=Pi Signage Chromium Kiosk
# kiosk.sh waits for the desktop (Wayland or X11) and the media server itself
After=graphical.target pi-signage.service
Wants=graphical.target
Requires=pi-signage.service

[Service]
Type=simple
User=INSTALL_USER
Environment=HOME=/home/INSTALL_USER
ExecStart=/opt/pi-signage/kiosk.sh
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
